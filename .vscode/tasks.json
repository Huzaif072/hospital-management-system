{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build SFML Project (macOS)",
            "type": "shell",
            "command": "make",
            "args": [],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "detail": "Builds the project using the Makefile with Homebrew SFML@2"
        },
        {
            "label": "Clean Build",
            "type": "shell",
            "command": "make",
            "args": ["clean"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": [],
            "detail": "Removes compiled object files and the binary"
        },
        {
            "label": "Run",
            "type": "shell",
            "command": "./HospitalManagement",
            "args": [],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "test",
            "problemMatcher": [],
            "detail": "Runs the compiled Hospital Management System"
        }
    ]
}